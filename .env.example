HTTP_ADDR=:8080
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/ai_recorder?sslmode=disable
MAX_UPLOAD_MB=200
WHISPER_CLI=C:\tools\whisper.cpp\build\bin\Release\whisper-cli.exe
WHISPER_MODEL=C:\tools\whisper.cpp\models\ggml-small.bin
# Язык речи: ru для русских записей, auto для автоматического определения
WHISPER_LANGUAGE=ru
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# Быстрый пересказ без долгих рассуждений; для thinking-only моделей включите true
OLLAMA_THINK=false
OLLAMA_MAX_TOKENS=768
# Модель остаётся в памяти между запросами; 0 — выгрузить сразу после ответа
OLLAMA_KEEP_ALIVE=5m

# FFmpeg нужен для обработки WebM/M4A/MP3 и нормализации WAV
FFMPEG_CLI=ffmpeg

# Число одновременных задач распознавания/анализа (1–8, по умолчанию 1)
PROCESSING_WORKERS=1

# Разные голоса: сначала scripts/setup-diarization.ps1 (бесплатно, локально)
DIARIZATION_ENABLED=false
DIARIZATION_PYTHON=.venv-diarization\Scripts\python.exe
DIARIZATION_SCRIPT=scripts/diarize.py
DIARIZATION_SEGMENTATION=models/diarization/sherpa-onnx-pyannote-segmentation-3-0/model.onnx
DIARIZATION_EMBEDDING=models/diarization/nemo_en_titanet_small.onnx
# Больше значение — меньше разных голосов. Подбирается под качество записи.
DIARIZATION_THRESHOLD=0.9
